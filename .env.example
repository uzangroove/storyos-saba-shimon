# StoryOS v21 — Supabase
# Copy to .env.local for local development. Never commit real secrets.

# Server-side PostgreSQL connection used by Drizzle migrations.
DATABASE_URL=postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres

# Supabase project URL, e.g. https://PROJECT_REF.supabase.co
SUPABASE_URL=https://PROJECT_REF.supabase.co

# Server only. Never prefix with NEXT_PUBLIC_ and never expose to browser code.
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key

# Browser-safe values can be added later when Auth/UI is wired.
# NEXT_PUBLIC_SUPABASE_URL=https://PROJECT_REF.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-anon-key
